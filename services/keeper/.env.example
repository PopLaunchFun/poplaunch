RPC_URL=https://api.mainnet-beta.solana.com
# Keypair of the buyback authority (BuybackVault.authority). Never commit it.
KEEPER_KEYPAIR=/secure/path/buyback-authority.json
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
SLIPPAGE_BPS=100
# Upper bound per run in lamports (the on-chain cap and escrow balance also apply)
MAX_AMOUNT=1000000000
