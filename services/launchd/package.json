{
  "name": "@pop/launchd",
  "version": "0.1.0",
  "private": true,
  "description": "Pop Launch backend: read-only chain sync of pop_launch launches/receipts/events into PostgreSQL (a cache, never the authority), metadata drafts and image uploads with wallet-signature auth, the public discovery API, and the settlement keeper.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/main.ts",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@hono/node-server": "2.1.3",
    "@pop/sdk": "workspace:*",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
