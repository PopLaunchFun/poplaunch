{
  "name": "poplaunch",
  "private": true,
  "version": "0.1.0",
  "description": "POP / Proof of Pain: a Solana price-bin market where matched trading fees become nonwithdrawable liquidity at fixed price bins.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './services/**' build",
    "test": "pnpm -r --filter './packages/**' --filter './services/**' test",
    "typecheck": "pnpm -r typecheck",
    "sim": "pnpm --filter @pop/simulator run scenarios",
    "web": "pnpm --filter @pop/web dev",
    "indexer": "pnpm --filter @pop/indexer start"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "tsx": "4.23.15",
    "fast-check": "4.10.2",
    "prettier": "3.9.9"
  }
}
