{
  "name": "@pop/math",
  "version": "0.1.0",
  "private": true,
  "description": "Executable integer specification of the POP price-bin market: prices, fees, swap walker, scar matching, graduation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
