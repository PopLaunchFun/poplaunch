  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
